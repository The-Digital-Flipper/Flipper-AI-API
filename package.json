{
  "name": "flipper-ai-api",
  "version": "1.0.0",
  "description": "A powerful API to scrape Facebook Marketplace vehicle listings, analyze pricing, and provide real-time alerts for undervalued deals.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --forceExit --runInBand",
    "test:coverage": "jest --coverage --forceExit --runInBand"
  },
  "keywords": [
    "facebook-marketplace",
    "car-flipping",
    "price-analysis",
    "real-time-alerts",
    "api"
  ],
  "author": "The-Digital-Flipper",
  "license": "MIT",
  "dependencies": {
    "axios": "1.13.5",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "5.2.1",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "joi": "17.13.3",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.13.2",
    "morgan": "1.10.1",
    "puppeteer": "24.40.0",
    "socket.io": "4.8.1",
    "uuid": "11.1.0",
    "winston": "3.17.0"
  },
  "devDependencies": {
    "jest": "29.7.0",
    "supertest": "7.2.2",
    "nodemon": "3.1.9"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
