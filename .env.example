# ─────────────────────────────────────────────
# Flipper AI API – Environment Variables
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/flipper-ai-api

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Scraper (optional overrides)
MIN_PROFIT_MARGIN_PERCENT=20
MAX_REPAIR_COST=5000
SCRAPER_POLL_INTERVAL_MS=900000   # 15 minutes

# Facebook credentials (pick one method)
# Option A: Saved cookie JSON string (preferred)
FB_COOKIES=

# Option B: Email + password login
FB_EMAIL=
FB_PASSWORD=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000   # 15 minutes
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
